# Nocturne Backend Environment Configuration Template
# Copy this file to .env and fill in your keys: cp .env.example .env

PORT=4000
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="replace_with_strong_secret"
JWT_REFRESH_SECRET="replace_with_strong_refresh_secret"

# Friday AI & External Integration Keys
GEMINI_API_KEY="your_gemini_api_key"
YOUTUBE_API_KEY="your_youtube_data_api_key"

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,https://localhost,capacitor://localhost,ionic://localhost"
